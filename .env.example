# Copy to .env and fill in. In production set these as real environment variables.

# development | test | staging | production (defaults to production when unset)
APP_ENV=development
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=crm

# Separate database for `make test`; its name must end in _test.
TEST_DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/crm_test

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Access-token (JWT) and refresh-token lifetimes. The refresh token is a
# rotating httpOnly cookie (Secure outside development/test).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Frontend origins allowed to call the API (comma-separated) and the base URL
# used for links in emails (required outside development).
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Outgoing mail (required outside development). Port 465 uses implicit TLS;
# other ports upgrade with STARTTLS when the server offers it. For local
# development, `docker compose up -d mailpit` and open http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CRM <no-reply@crm.local>

# Temporary: return the reset token in the forgot-password response so the
# current frontend keeps working. Only honored with APP_ENV=development; the
# server refuses to start if it is true in any other environment.
RETURN_RESET_TOKEN_IN_RESPONSE=false

# debug | info | warn | error, and text | json (json by default outside development)
LOG_LEVEL=info
LOG_FORMAT=

# WhatsApp Cloud API (Meta). Optional; set each pair together.
# Webhook: configure https://<api-host>/api/v1/webhooks/whatsapp in the Meta
# app with WHATSAPP_VERIFY_TOKEN, subscribe to "messages", then register each
# number's phone_number_id with POST /api/v1/whatsapp-accounts.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Sending (nurture). Messages go out from the number the org registered
# with POST /api/v1/whatsapp-accounts. Graph API version: check
# developers.facebook.com/docs/graph-api/changelog for the current one.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
